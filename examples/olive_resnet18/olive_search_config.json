{
  "input_model": {
    "type": "ONNXModel",
    "model_path": "examples/resnet18-cpu1t/models/resnet18-fp32.onnx"
  },
  "systems": {
    "local_system": {
      "type": "LocalSystem",
      "accelerators": [{"device": "cpu", "execution_providers": ["CPUExecutionProvider"]}]
    }
  },
  "data_configs": [
    {
      "name": "calib",
      "user_script": "examples/olive_resnet18/olive_data.py",
      "load_dataset_config": {"type": "imagenette_calib", "limit": 64},
      "dataloader_config": {"batch_size": 1}
    },
    {
      "name": "eval",
      "user_script": "examples/olive_resnet18/olive_data.py",
      "load_dataset_config": {"type": "imagenette_eval", "limit": 256},
      "post_process_data_config": {"type": "top1"},
      "dataloader_config": {"batch_size": 1}
    }
  ],
  "evaluators": {
    "common_evaluator": {
      "metrics": [
        {
          "name": "accuracy",
          "type": "accuracy",
          "data_config": "eval",
          "sub_types": [
            {
              "name": "accuracy_score",
              "priority": 1,
              "metric_config": {"task": "multiclass", "num_classes": 1000},
              "goal": {"type": "max-degradation", "value": 0.01}
            }
          ],
          "user_config": {
            "inference_settings": {"onnx": {"session_options": {"intra_op_num_threads": 4}}}
          }
        },
        {
          "name": "latency",
          "type": "latency",
          "data_config": "eval",
          "sub_types": [{"name": "p50", "priority": 2}],
          "user_config": {
            "inference_settings": {"onnx": {"session_options": {"intra_op_num_threads": 4}}}
          }
        }
      ]
    }
  },
  "passes": {
    "quantization": {"type": "OnnxStaticQuantization", "data_config": "calib"}
  },
  "engine": {
    "search_strategy": {
      "execution_order": "joint",
      "sampler": "tpe",
      "sampler_config": {"seed": 0},
      "max_iter": 30,
      "output_model_num": 3
    },
    "evaluator": "common_evaluator",
    "evaluate_input_model": true,
    "host": "local_system",
    "target": "local_system",
    "cache_dir": "scratch/olive_cache_search",
    "output_dir": "scratch/olive_out/search"
  }
}
